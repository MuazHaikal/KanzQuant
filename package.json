{
  "name": "kanzquant",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:focus": "node --env-file=.env.local scripts/test_focus.mjs",
    "test:context": "node --env-file=.env.local scripts/test_context.mjs",
    "test:visual": "node scripts/test_visual.mjs",
    "test:market": "node --env-file=.env.local scripts/test_market.mjs",
    "test:hypothesis": "node --env-file=.env.local scripts/test_hypothesis.mjs",
    "test:hypothesis-service": "node --env-file=.env.local scripts/test_hypothesis_service.mjs",
    "test:hypothesis-client": "node scripts/test_hypothesis_client.mjs",
    "hypothesis:reproduce": "node scripts/run_python.mjs scripts/reproduce_hypothesis.py",
    "hypothesis:configure": "node scripts/configure_hypothesis.mjs",
    "hypothesis:api": "node --env-file=.env.local scripts/run_python.mjs -m uvicorn services.hypothesis_api.main:app --host 127.0.0.1 --port 8001 --workers 1 --no-access-log",
    "research": "node scripts/run_python.mjs scripts/run_research.py",
    "research:verify": "node scripts/run_python.mjs scripts/verify_research.py",
    "ingest:fred": "node scripts/run_python.mjs scripts/ingest_fred.py",
    "ingest:market": "node scripts/run_python.mjs scripts/ingest_market.py",
    "bootstrap": "node scripts/run_python.mjs scripts/bootstrap_demo.py",
    "db:setup": "node scripts/run_python.mjs scripts/setup_database.py",
    "db:verify": "node scripts/run_python.mjs scripts/setup_database.py --verify-only"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
