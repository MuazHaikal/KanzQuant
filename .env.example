# Server-only pooled Neon connection string. Never expose this to the browser.
DATABASE_URL=

# Used by the offline FRED ingestion job, not the Next.js web process.
FRED_API_KEY=

# Production and real-data development mode.
KANZQUANT_DATA_MODE=database

# Next.js server only: local FastAPI for development; remote HTTPS Render URL on Vercel.
HYPOTHESIS_API_URL=http://127.0.0.1:8001
HYPOTHESIS_EXECUTION_MODE=local
# Same cryptographically random secret (at least 32 bytes) on Next.js and Render.
HYPOTHESIS_RUN_SECRET=
# Render only: exact origins. Add preview origins explicitly, never a wildcard.
ALLOWED_ORIGINS=https://kanz-quant.vercel.app,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
